# ------------------------------------------------------------
# 1. DATASETS
# ------------------------------------------------------------

# Raw datasets
data/raw/
data/**/*.csv
data/**/*.csv.gz
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz
data/**/*.parquet
data/**/*.json
data/**/*.jsonl

# Processed/generated data
data/processed/
data/bronze/
data/silver/
data/gold/
data/quarantine/

# Allow directory structure to exist in Git
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
!data/quarantine/.gitkeep


